{
  "name": "magazin-telegram",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-local.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "bot:setup": "node --env-file=.env.local scripts/setup-bot.mjs",
    "dev:local": "node scripts/dev-local.mjs",
    "dev:telegram": "next dev --hostname 127.0.0.1"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "pg": "^8.16.0",
    "zod": "^4.0.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/pg": "^8.15.0",
    "tsx": "^4.20.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
