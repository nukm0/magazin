# Только серверные переменные. Не добавляйте NEXT_PUBLIC_ к секретам.
TELEGRAM_BOT_TOKEN=replace_with_new_botfather_token
OWNER_TELEGRAM_ID=998579758
NEXT_PUBLIC_BOT_USERNAME=magazinptz_bot
APP_URL=https://replace-after-vercel-deploy.vercel.app
# Постоянная PostgreSQL. Не используйте файловую БД на Vercel.
DATABASE_URL=postgresql://user:password@host:5432/magazin?sslmode=require
# Случайная строка, 32+ символов: заголовок webhook Telegram.
TELEGRAM_WEBHOOK_SECRET=replace_with_random_32_character_secret

# Включать только после применения db/002_notifications.sql.
NOTIFICATIONS_ENABLED=0
# Секрет для планового обработчика уведомлений, 32+ символов.
NOTIFICATION_CRON_SECRET=replace_with_random_worker_secret
